# SOFIA 2.0 — Environment template (TASK-002 / PRD §37, §38)
# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Secret server-only: tidak ada yang diawali NEXT_PUBLIC_* kecuali APP_URL.

NODE_ENV=development

# --- SOFIA core ---
SOFIA_BASE_URL=http://localhost:3000
AUTH_SECRET=ganti-dengan-string-acak-min-32-karakter
ENCRYPTION_KEY=ganti-dengan-string-acak-min-32-karakter

# --- Paperclip (source of truth: orgs, agents, projects, goals, tasks, runs) ---
PAPERCLIP_BASE_URL=
PAPERCLIP_API_KEY=

# --- 9Router gateway (LLM routing utama, PRD §14) ---
ROUTER_BASE_URL=
ROUTER_API_KEY=

# --- n8n automation (external, PRD §34) ---
N8N_BASE_URL=https://auton8n.dsln.my.id
N8N_API_KEY=

# --- OpenRouter fallback (PRD §15) ---
OPENROUTER_API_KEY=

# --- Local LLM opsional (boleh offline, PRD §16) ---
LOCAL_LLM_BASE_URL=

# --- Data: Neon PostgreSQL (produksi) / Docker Postgres (dev) ---
# Format Neon: postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=
REDIS_URL=

# --- Docker compose (Postgres/Redis lokal) ---
POSTGRES_USER=sofia
POSTGRES_PASSWORD=sofia-dev-only
POSTGRES_DB=sofia
POSTGRES_PORT=5432
REDIS_PORT=6379
SOFIA_PORT=3000

# --- Legacy V1 (tetap didukung sampai TASK-003; Supabase Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
